{
  "name": "react-parcel-app",
  "version": "1.0.0",
  "description": "RL",
  "main": "src/App.js",
  "scripts": {
    "build": "parcel build --public-url ./dist/ src/index.html",
    "start": "pnpm run build && babel-node server/server.js",
    "dev": "parcel src/index.html",
    "dev:mock": "cross-env PET_MOCK=mock pnpm run dev",
    "format": "prettier --write \"src/**/*.{js,jsx,html}\"",
    "lint": "eslint \"src/**/*.{js,jsx}\" --quiet",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:watch": "jest --watch",
    "test:update": "jest -u"
  },
  "keywords": [],
  "author": "Rocky L",
  "license": "ISC",
  "engines": {
    "node": "24.14.0",
    "pnpm": "10.28.0"
  },
  "packageManager": "pnpm@10.28.0",
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/node": "^7.29.0",
    "@babel/preset-env": "^7.29.2",
    "@babel/preset-react": "^7.28.5",
    "@testing-library/react": "^16.3.2",
    "babel-eslint": "^10.1.0",
    "cross-env": "^10.1.0",
    "eslint": "^10.1.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "jest": "^30.3.0",
    "parcel-bundler": "^1.12.5",
    "prettier": "^3.8.1"
  },
  "dependencies": {
    "@emotion/core": "^11.0.0",
    "@frontendmasters/pet": "^1.0.3",
    "@reach/router": "^1.3.4",
    "express": "^5.2.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "browserslist": [
    "last 2 Chrome versions",
    "last 2 ChromeAndroid versions",
    "last 2 Firefox versions",
    "last 2 FirefoxAndroid versions",
    "last 2 Safari versions",
    "last 2 iOS versions",
    "last 2 Edge versions"
  ]
}
